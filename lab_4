import pandas as pd
import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# УЗЕЛ ДЕРЕВА (общий для регрессии и классификации)
# ============================================================
class Node:
    def __init__(self, feature=None, threshold=None,
                 left=None, right=None, value=None):
        self.feature   = feature      # номер колонки (0,1,2) или None
        self.threshold = threshold    # порог или None
        self.left      = left         # левое поддерево
        self.right     = right        # правое поддерево
        self.value     = value        # предсказание (только у листа!)


# ============================================================
# 1. ДЕРЕВО РЕГРЕССИИ
# ============================================================
class RegressionTree:
    def __init__(self, max_depth=10, min_samples_split=2, min_samples_leaf=1):
        self.max_depth = max_depth
        self.min_samples_split = min_samples_split
        self.min_samples_leaf = min_samples_leaf
        self.root = None

    # ---------- публичные методы ----------
    def fit(self, X, y):
        X = np.asarray(X, dtype=float)
        y = np.asarray(y, dtype=float)
        self.root = self._build(X, y, depth=0)
        return self

    def predict(self, X):
        X = np.asarray(X, dtype=float)
        return np.array([self._predict_one(x, self.root) for x in X])

    # ---------- внутренние методы ----------
    def _predict_one(self, x, node):
        # спуск по дереву, пока не лист
        while node.value is None:
            if x[node.feature] <= node.threshold:
                node = node.left
            else:
                node = node.right
        return node.value

    def _impurity(self, y):
        # для регрессии impurity = дисперсия
        if len(y) == 0:
            return 0.0
        return np.var(y)

    def _split_gain(self, y, y_left, y_right):
        # gain = impurity_до - взвешенная impurity_после
        n = len(y)
        n_left  = len(y_left)
        n_right = len(y_right)

        impurity_before = self._impurity(y)
        impurity_after  = ((n_left / n)  * self._impurity(y_left)
                         + (n_right / n) * self._impurity(y_right))
        return impurity_before - impurity_after

    def _best_split(self, X, y):
        # перебор всех (feature, threshold), выбор max gain
        best_gain = -np.inf
        best_feature = None
        best_threshold = None

        n_features = X.shape[1]

        for feature in range(n_features):
            for threshold in np.unique(X[:, feature]):
                left_mask  = X[:, feature] <= threshold
                right_mask = ~left_mask

                # проверка min_samples_leaf
                if left_mask.sum() < self.min_samples_leaf or \
                   right_mask.sum() < self.min_samples_leaf:
                    continue

                y_left  = y[left_mask]
                y_right = y[right_mask]

                if len(y_left) == 0 or len(y_right) == 0:
                    continue

                gain = self._split_gain(y, y_left, y_right)

                if gain > best_gain:
                    best_gain = gain
                    best_feature = feature
                    best_threshold = threshold

        return best_feature, best_threshold

    def _build(self, X, y, depth):
        # 1. проверка остановки
        if (depth >= self.max_depth
                or len(y) < self.min_samples_split
                or len(np.unique(y)) == 1):
            return Node(value=float(np.mean(y)))

        # 2. лучший разрез
        feature, threshold = self._best_split(X, y)

        # 3. нечем делить - лист
        if feature is None:
            return Node(value=float(np.mean(y)))

        # 4. разделить и рекурсивно построить детей
        left_mask  = X[:, feature] <= threshold
        right_mask = ~left_mask

        left  = self._build(X[left_mask],  y[left_mask],  depth + 1)
        right = self._build(X[right_mask], y[right_mask], depth + 1)

        # 5. вернуть внутренний узел
        return Node(feature, threshold, left, right)


# ============================================================
# 2. ДЕРЕВО КЛАССИФИКАЦИИ
# ============================================================
class ClassificationTree:
    def __init__(self, max_depth=10, min_samples_split=2, min_samples_leaf=1):
        self.max_depth = max_depth
        self.min_samples_split = min_samples_split
        self.min_samples_leaf = min_samples_leaf
        self.root = None

    def fit(self, X, y):
        X = np.asarray(X, dtype=float)
        y = np.asarray(y)
        self.root = self._build(X, y, depth=0)
        return self

    def predict(self, X):
        X = np.asarray(X, dtype=float)
        return np.array([self._predict_one(x, self.root) for x in X])

    # ---------- внутренние ----------
    def _predict_one(self, x, node):
        while node.value is None:
            if x[node.feature] <= node.threshold:
                node = node.left
            else:
                node = node.right
        return node.value

    def _impurity(self, y):
        # для классификации impurity = Gini
        if len(y) == 0:
            return 0.0
        _, counts = np.unique(y, return_counts=True)
        p = counts / counts.sum()
        return 1.0 - np.sum(p ** 2)

    def _split_gain(self, y, y_left, y_right):
        n = len(y)
        n_left  = len(y_left)
        n_right = len(y_right)

        impurity_before = self._impurity(y)
        impurity_after  = ((n_left / n)  * self._impurity(y_left)
                         + (n_right / n) * self._impurity(y_right))
        return impurity_before - impurity_after

    def _best_split(self, X, y):
        best_gain = -np.inf
        best_feature = None
        best_threshold = None

        n_features = X.shape[1]

        for feature in range(n_features):
            for threshold in np.unique(X[:, feature]):
                left_mask  = X[:, feature] <= threshold
                right_mask = ~left_mask

                if left_mask.sum() < self.min_samples_leaf or \
                   right_mask.sum() < self.min_samples_leaf:
                    continue

                y_left  = y[left_mask]
                y_right = y[right_mask]

                if len(y_left) == 0 or len(y_right) == 0:
                    continue

                gain = self._split_gain(y, y_left, y_right)

                if gain > best_gain:
                    best_gain = gain
                    best_feature = feature
                    best_threshold = threshold

        return best_feature, best_threshold

    def _majority(self, y):
        # самый частый класс
        vals, counts = np.unique(y, return_counts=True)
        return vals[np.argmax(counts)]

    def _build(self, X, y, depth):
        if (depth >= self.max_depth
                or len(y) < self.min_samples_split
                or len(np.unique(y)) == 1):
            return Node(value=self._majority(y))

        feature, threshold = self._best_split(X, y)

        if feature is None:
            return Node(value=self._majority(y))

        left_mask  = X[:, feature] <= threshold
        right_mask = ~left_mask

        left  = self._build(X[left_mask],  y[left_mask],  depth + 1)
        right = self._build(X[right_mask], y[right_mask], depth + 1)

        return Node(feature, threshold, left, right)


# ============================================================
# 3. study_score.csv
# ============================================================
if __name__ == "__main__":
    # ---------- загрузка ----------
    df = pd.read_csv('C:/ML_2026/data/Lab_4/study_score.csv')
    print("Data:")
    print(df)
    print()

    X = df[['StudyHours', 'SleepHours', 'CoffeeCups']].values
    y_reg = df['Score'].values

    # ============================================================
    # 3.1 РЕГРЕССИЯ
    # ============================================================
    print("=" * 60)
    print("regresion: predictions of Score")
    print("=" * 60)

    tree = RegressionTree(max_depth=5)
    tree.fit(X, y_reg)
    preds = tree.predict(X)

    print("Predictions:", np.round(preds, 2))
    print("True       :", y_reg)
    print("MSE        :", round(np.mean((preds - y_reg) ** 2), 4))

    # проверка переобучения: глубина 10 vs 1
    for d in [1, 3, 10]:
        t = RegressionTree(max_depth=d)
        t.fit(X, y_reg)
        p = t.predict(X)
        mse = np.mean((p - y_reg) ** 2)
        print(f"max_depth={d:2d} -> MSE = {mse:.4f}")

    # график StudyHours -> Score
    plt.figure(figsize=(7, 4))
    plt.scatter(df['StudyHours'], df['Score'], color='blue', label='data')

    grid = np.linspace(df['StudyHours'].min() - 0.5,
                       df['StudyHours'].max() + 0.5, 300)
    grid_X = np.tile(X.mean(axis=0), (len(grid), 1))
    grid_X[:, 0] = grid

    plt.plot(grid, tree.predict(grid_X), color='red', label='tree')
    plt.xlabel('StudyHours')
    plt.ylabel('Score')
    plt.title('Regression Tree: StudyHours -> Score')
    plt.legend()
    plt.tight_layout()
    plt.show()

    # ============================================================
    # 3.2 КЛАССИФИКАЦИЯ
    # ============================================================
    print()
    print("=" * 60)
    print("classification: Pass = (Score >= 10)")
    print("=" * 60)

    df['Pass'] = (df['Score'] >= 10).astype(int)
    y_cls = df['Pass'].values

    clf = ClassificationTree(max_depth=4)
    clf.fit(X, y_cls)
    preds_cls = clf.predict(X)

    acc = np.mean(preds_cls == y_cls)
    print("Predictions:", preds_cls)
    print("True       :", y_cls)
    print("Accuracy   :", round(acc, 4))

    # проверка переобучения
    for d in [1, 3, 10]:
        c = ClassificationTree(max_depth=d)
        c.fit(X, y_cls)
        p = c.predict(X)
        print(f"max_depth={d:2d} -> Accuracy = {np.mean(p == y_cls):.4f}")

    # decision regions: StudyHours vs SleepHours, CoffeeCups = среднее
    xx, yy = np.meshgrid(
        np.linspace(X[:, 0].min() - 0.5, X[:, 0].max() + 0.5, 200),
        np.linspace(X[:, 1].min() - 0.5, X[:, 1].max() + 0.5, 200),
    )
    grid = np.c_[xx.ravel(), yy.ravel(), np.full(xx.size, X[:, 2].mean())]
    Z = clf.predict(grid).reshape(xx.shape)

    plt.figure(figsize=(6, 5))
    plt.contourf(xx, yy, Z, alpha=0.3, cmap='coolwarm')
    plt.scatter(X[:, 0], X[:, 1], c=y_cls,
                edgecolor='k', cmap='coolwarm', s=80)
    plt.xlabel('StudyHours')
    plt.ylabel('SleepHours')
    plt.title('Classification Tree: decision regions')
    plt.tight_layout()
    plt.show()
