#print('X_features', X_features)
#print('y_centered', y_centered)
#print('for b : ', for_b, sep='\n')
#print('b: ', b, sep='\n')
#print("b_0: ", b_0)

class MultipleLinearRegression:
    def fit(self, X, y):
        y_mean = np.mean(y)
        self.X_mean = np.mean(X, axis=0)
        X_centered = X - self.X_mean
        X_features = X_centered[:, 1:]
        y_centered = y - y_mean
        for_b = np.linalg.inv((X_features.T @ X_features)) @ X_features.T
        self.b = for_b @ y_centered
        self.b_0 = y_mean - self.b @ self.X_mean[1:]

    def predict(self, X):
        predictions = self.b_0 + X[:,1:] @ self.b
        print('b_0', self.b_0)
        print('b', self.b)
        return predictions

model = MultipleLinearRegression()
model.fit(X, y)
predictions = model.predict(X)
print(predictions)

e_residuals = y - predictions
print('error', e_residuals)
MSE = np.sum(e_residuals**2)/len(e_residuals)
print('MSE: ', MSE)
RMSE = np.sqrt(MSE)
print('RMSE: ', RMSE)


plt.figure()
plt.scatter(y, predictions)
plt.xlabel('Actual Y')
plt.ylabel('Predicted Y')
plt.title('Actual vs Predicted')
plt.plot([y.min(), y.max()], [y.min(), y.max()], 'r--')
plt.show()


