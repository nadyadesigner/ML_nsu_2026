import numpy as np
import pandas as pd
from ucimlrepo import fetch_ucirepo
import matplotlib.pyplot as plt
import seaborn as sns
sns.set(style="darkgrid")

X = np.array([[1], [2], [3], [4], [5]])
y = np.array([1, 2, 1.3, 3.75, 2.25])
print("X:", X)
print("y:", y)
mean_X = np.mean(X)
print(X-mean_X)

#print('mean: ', mean_X, mean_y)

class SimpleLinearRegression:
    def fit(self, X, y):
        X = X.flatten()
        mean_X = np.mean(X)
        mean_y = np.mean(y)
        X_i = X - mean_X
        y_i = y - mean_y
        b_1 = np.sum(X_i*y_i)/np.sum((X_i)**2)
        b_0 = mean_y - b_1 * mean_X
        self.b_0 = b_0
        self.b_1 = b_1
    def predict(self, X):
        X = X.flatten()
        predictions = self.b_0 + self.b_1 * X
        print('b_0: ', self.b_0)
        print('b_1: ', self.b_1)
        return predictions


model = SimpleLinearRegression()
model.fit(X, y)
predictions = model.predict(X)
print(predictions)

plt.figure()
plt.scatter(X,y)
plt.scatter(X, predictions)
plt.plot(X, predictions)
plt.xlabel("X")
plt.ylabel("y")
plt.title("Simple Linear Regression")
plt.legend(["Regression line", "Actual values"])
plt.show()


