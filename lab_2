    [
        [1,1,1],
        [1,1,2],
        [1,2,2],
        [1,0,1]
    ]
)

y = np.array([
    3.25,
    6.5,
    3.5,
    5.0
])

#print('X: ', X, sep='\n')
#print('y: ', y)
#print('X mean: ', X_mean)
